# ── CS Card Station backend configuration ──
# Copy to .env and fill in. NEVER commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000

# MySQL 8 (e.g. Aiven). Prisma URL format - note Prisma's TLS options instead of `ssl-mode=REQUIRED`:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=accept_invalid_certs&connection_limit=10&pool_timeout=20&connect_timeout=15
# To also verify the server certificate, save the provider's CA as backend/certs/ca.pem and use
#   ...?sslcert=../certs/ca.pem&sslaccept=strict&connection_limit=10&pool_timeout=20&connect_timeout=15
# A local MySQL works too: mysql://root:PASSWORD@localhost:3306/cs_card_station
# The e2e tests use a separate database named cs_card_station_test on the same server (created automatically).
DATABASE_URL=
# Optional. Enables multi-instance presence. Leave empty for single-instance dev.
REDIS_URL=

# Required, min 32 chars each. SESSION_SECRET signs nothing user-facing today but is
# reserved for session-based integrations; JWT_SECRET signs player access tokens.
SESSION_SECRET=
JWT_SECRET=
OTP_SECRET=

APP_URL=http://localhost:3001
API_URL=http://localhost:3000
# Comma-separated list of browser origins allowed by CORS (admin panel).
CORS_ORIGINS=http://localhost:3001

# SMTP for OTP emails. Empty EMAIL_HOST in development logs codes to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=CS Card Station <no-reply@example.com>

# Firebase service account: path to JSON file or the JSON itself. Empty disables push.
FCM_CREDENTIALS=

# S3-compatible object storage (avatars/banners uploads)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Token lifetimes
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# First super admin, created by `npm run db:seed` only if it does not exist yet.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
